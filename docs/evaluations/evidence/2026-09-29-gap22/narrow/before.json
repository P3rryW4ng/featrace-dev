  "diff": "diff --git a/src/audit/summary.py b/src/audit/summary.py\nindex 4a5f623..88f8522 100644\n--- a/src/audit/summary.py\n+++ b/src/audit/summary.py\n@@ -1,3 +1,51 @@\n+import re\n+from datetime import datetime\n+\n+_TIMESTAMP_PATTERN = re.compile(r\"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z\")\n+\n def legacy_summary(events):\n     \"\"\"Existing summary counts every input event, including duplicates.\"\"\"\n     return {\"total\": len(events)}\n+\n+def _valid_timestamp(value):\n+    if not isinstance(value, str) or _TIMESTAMP_PATTERN.fullmatch(value) is None:\n+        return False\n+    try:\n+        datetime(int(value[0:4]), int(value[5:7]), int(value[8:10]),\n+                 int(value[11:13]), int(value[14:16]), int(value[17:19]))\n+    except ValueError:\n+        return False\n+    return True\n+\n+def _event_error(event):\n+    \"\"\"Return the first invalid field reason for an event, or None.\"\"\"\n+    event_id = event.get(\"id\")\n+    if not isinstance(event_id, str) or event_id == \"\":\n+        return \"invalid_id\"\n+    kind = event.get(\"kind\")\n+    if not isinstance(kind, str) or kind == \"\":\n+        return \"invalid_kind\"\n+    if not _valid_timestamp(event.get(\"timestamp\")):\n+        return \"invalid_timestamp\"\n+    return None\n+\n+def event_snapshot(events, start=None, end=None):\n+    \"\"\"Count first valid in-window events per id; the fixed-width format orders as text.\"\"\"\n+    counts = {}\n+    accepted_ids = []\n+    errors = []\n+    seen_ids = set()\n+    for index, event in enumerate(events):\n+        reason = _event_error(event)\n+        if reason is not None:\n+            errors.append({\"index\": index, \"reason\": reason})\n+            continue\n+        timestamp = event[\"timestamp\"]\n+        if (start is not None and timestamp < start) or (end is not None and timestamp > end):\n+            continue\n+        if event[\"id\"] in seen_ids:\n+            continue\n+        seen_ids.add(event[\"id\"])\n+        accepted_ids.append(event[\"id\"])\n+        counts[event[\"kind\"]] = counts.get(event[\"kind\"], 0) + 1\n+    return {\"counts\": counts, \"accepted_ids\": accepted_ids, \"errors\": errors}\ndiff --git a/src/catalog/query.py b/src/catalog/query.py\nindex bb78bbc..bcc4431 100644\n--- a/src/catalog/query.py\n+++ b/src/catalog/query.py\n@@ -1,3 +1,5 @@\n+import re\n+\n from src.shared.formatting import receipt_code\n \n def receipt_for(reference):\n@@ -6,3 +8,47 @@ def receipt_for(reference):\n \n def all_product_ids(items):\n     return [item[\"id\"] for item in items]\n+\n+_PRICE_PATTERN = re.compile(r\"[0-9]+(?:\\.[0-9]{1,2})?\")\n+LABEL_LENGTH = 8\n+\n+def _product_error(item):\n+    \"\"\"Return the first invalid field reason for an item, or None.\"\"\"\n+    item_id = item.get(\"id\")\n+    if not isinstance(item_id, str) or item_id == \"\":\n+        return \"invalid_id\"\n+    if not isinstance(item.get(\"name\"), str):\n+        return \"invalid_name\"\n+    if not isinstance(item.get(\"active\"), bool):\n+        return \"invalid_active\"\n+    if not isinstance(item.get(\"category\"), str):\n+        return \"invalid_category\"\n+    price = item.get(\"price\")\n+    if not isinstance(price, str) or _PRICE_PATTERN.fullmatch(price) is None:\n+        return \"invalid_price\"\n+    return None\n+\n+def _two_decimal_price(price):\n+    # String arithmetic only, so the caller's decimal context is never touched.\n+    whole, _, fraction = price.partition(\".\")\n+    return (whole.lstrip(\"0\") or \"0\") + \".\" + (fraction + \"00\")[:2]\n+\n+def product_snapshot(items, category=None):\n+    \"\"\"Validate every item, then list active products matching the category.\"\"\"\n+    products = []\n+    errors = []\n+    for index, item in enumerate(items):\n+        reason = _product_error(item)\n+        if reason is not None:\n+            errors.append({\"index\": index, \"reason\": reason})\n+            continue\n+        if not item[\"active\"]:\n+            continue\n+        if category is not None and item[\"category\"] != category:\n+            continue\n+        products.append({\n+            \"id\": item[\"id\"],\n+            \"label\": item[\"name\"][:LABEL_LENGTH],\n+            \"price\": _two_decimal_price(item[\"price\"]),\n+        })\n+    return {\"products\": products, \"errors\": errors}\n",
