+import csv
+import io
+from decimal import Decimal, InvalidOperation
+
+_HEADER = ['sku', 'name', 'price']
+
+
+def _parse_price(value):
+    try:
+        price = Decimal(value)
+    except (InvalidOperation, ValueError):
+        return None
+    if not price.is_finite() or price < 0 or price.as_tuple().exponent < -2:
+        return None
+    if price == 0:
+        price = Decimal(0)
+    return '{:.2f}'.format(price)
+
+
 def convert(text):
-    raise NotImplementedError
+    records = []
+    errors = []
+    if text.startswith('\ufeff'):
+        text = text[1:]
+    if text == '':
+        return {'records': records, 'errors': errors}
+    rows = csv.reader(io.StringIO(text, newline=''))
+    header = next(rows, None)
+    if header is None or [field.strip() for field in header] != _HEADER:
+        errors.append({'line': 1, 'code': 'header'})
+        return {'records': records, 'errors': errors}
+    seen = set()
+    for line, row in enumerate(rows, start=2):
+        if len(row) != len(_HEADER):
+            errors.append({'line': line, 'code': 'invalid_row'})
+            continue
+        sku, name, raw_price = (field.strip() for field in row)
+        if not sku or not name:
+            errors.append({'line': line, 'code': 'invalid_row'})
+            continue
+        price = _parse_price(raw_price)
+        if price is None:
+            errors.append({'line': line, 'code': 'invalid_price'})
+            continue
+        if sku in seen:
+            errors.append({'line': line, 'code': 'duplicate_sku'})
+            continue
+        seen.add(sku)
+        records.append({'sku': sku, 'name': name, 'price': price})
+    return {'records': records, 'errors': errors}
