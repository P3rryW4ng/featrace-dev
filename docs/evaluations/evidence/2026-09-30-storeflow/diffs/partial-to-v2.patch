@@ -0,0 +1,135 @@
+import unittest
+from src.storeflow import catalog
+from src.storeflow.storefront import preview
+from src.storeflow.pricing import calculate_total
+from src.storeflow.legacy_export import export_subtotal
+from src.storeflow.inventory import Inventory
+from src.storeflow.payments import Ledger, PaymentDeclined
+from src.storeflow.checkout import Checkout
+from src.storeflow.receipts import Receipt, export_receipt
+
+def make(stock):
+    inv=Inventory(stock);ledger=Ledger();return inv,ledger,Checkout(inv,ledger)
+
+def snapshot(inv, ledger, shop):
+    return (dict(inv.stock), dict(ledger.charges), ledger.charge_count, dict(shop.receipts))
+
+class MemberCheckoutTests(unittest.TestCase):
+    def test_default_and_false_charge_undiscounted(self):
+        inv,ledger,shop=make({"book":5})
+        self.assertEqual(shop.place_order("d-1",[("book",2)]).paid_cents,10000)
+        self.assertEqual(shop.place_order("d-2",[("book",1)],member=False).paid_cents,5000)
+        self.assertEqual(shop.place_order("d-3",[("book",1)],False).paid_cents,5000)
+        self.assertEqual(ledger.charges,{"d-1":10000,"d-2":5000,"d-3":5000})
+    def test_member_charges_v2_policy(self):
+        # v2 (CHG-001): 15% floored, capped at 1200 cents per order
+        inv,ledger,shop=make({"book":10,"pen":10,"bag":2})
+        self.assertEqual(shop.place_order("m-1",[("book",1)],member=True).paid_cents,4250)
+        self.assertEqual(shop.place_order("m-2",[("book",2)],member=True).paid_cents,8800)
+        self.assertEqual(shop.place_order("m-3",[("pen",3)],True).paid_cents,1275)
+        self.assertEqual(shop.place_order("m-4",[("bag",2)],member=True).paid_cents,28800)
+        self.assertEqual(ledger.charges,{"m-1":4250,"m-2":8800,"m-3":1275,"m-4":28800})
+    def test_member_charge_equals_preview_total(self):
+        original=dict(catalog.PRICES)
+        try:
+            catalog.PRICES["odd"]=1999
+            cases=[[("book",1)],[("pen",1)],[("book",1),("pen",6)],[("book",1),("book",1)],[("bag",1),("pen",9)],[("odd",1)],[("odd",4)]]
+            for i,lines in enumerate(cases):
+                inv,ledger,shop=make({"book":5,"pen":10,"bag":2,"odd":5})
+                expected=preview(lines,member=True)["total_cents"]
+                r=shop.place_order("p-%d"%i,lines,member=True)
+                self.assertEqual(r.paid_cents,expected,lines)
+                self.assertEqual(ledger.charges["p-%d"%i],expected)
+        finally:
+            catalog.PRICES.clear();catalog.PRICES.update(original)
+    def test_receipt_type_and_export_format(self):
+        inv,ledger,shop=make({"book":2})
+        r=shop.place_order("fmt",[("book",1)],member=True)
+        self.assertIs(type(r),Receipt)
+        self.assertEqual(export_receipt(r),{"receipt_id":"fmt","amount_cents":4250})
+        self.assertIs(type(r.paid_cents),int)
+    def test_repeat_returns_original_receipt_despite_different_input(self):
+        inv,ledger,shop=make({"book":3,"pen":3})
+        r=shop.place_order("same",[("book",1)])
+        before=snapshot(inv,ledger,shop)
+        for lines,member in [([("book",1)],True),([("pen",2)],False),([("bad",1)],True),([("book",0)],False),([("book",True)],False),([],True),([("book",99)],False)]:
+            self.assertIs(shop.place_order("same",lines,member=member),r)
+        self.assertEqual(snapshot(inv,ledger,shop),before)
+        self.assertEqual(r.paid_cents,5000)
+    def test_repeat_member_receipt_not_replaced_by_non_member_repeat(self):
+        inv,ledger,shop=make({"book":3})
+        r=shop.place_order("mem",[("book",1)],member=True)
+        self.assertIs(shop.place_order("mem",[("book",1)]),r)
+        self.assertEqual(r.paid_cents,4250);self.assertEqual(ledger.charge_count,1);self.assertEqual(inv.stock["book"],2)
+
+class AtomicCheckoutTests(unittest.TestCase):
+    def assert_fails_unchanged(self, stock, lines, member, exc):
+        inv,ledger,shop=make(stock)
+        shop.place_order("prior",[("book",1)])
+        before=snapshot(inv,ledger,shop)
+        with self.assertRaises(exc):shop.place_order("fail",lines,member=member)
+        self.assertEqual(snapshot(inv,ledger,shop),before)
+        self.assertNotIn("fail",shop.receipts)
+    def test_validation_failure_unchanged(self):
+        for lines in [[("bad",1)],[("book",1),("bad",1)],[("book",0)],[("book",-1)],[("book",True)],[("book",1.0)]]:
+            for member in (False,True):
+                self.assert_fails_unchanged({"book":5},lines,member,ValueError)
+    def test_insufficient_stock_unchanged(self):
+        for member in (False,True):
+            self.assert_fails_unchanged({"book":5,"pen":2},[("book",1),("pen",3)],member,ValueError)
+            self.assert_fails_unchanged({"book":1},[("book",1)],member,ValueError)
+    def test_repeated_sku_stock_combined(self):
+        for member in (False,True):
+            self.assert_fails_unchanged({"book":2},[("book",1),("book",1)],member,ValueError)
+        inv,ledger,shop=make({"book":2})
+        r=shop.place_order("ok",[("book",1),("book",1)],member=True)
+        self.assertEqual(inv.stock["book"],0);self.assertEqual(r.paid_cents,8800)
+    def test_empty_order_raises(self):
+        for member in (False,True):
+            self.assert_fails_unchanged({"book":5},[],member,ValueError)
+    def test_decline_unchanged_then_retry_succeeds_once(self):
+        for member,amount in ((False,10000),(True,8800)):
+            inv,ledger,shop=make({"book":3})
+            ledger.decline_next=True
+            before=snapshot(inv,ledger,shop)
+            with self.assertRaises(PaymentDeclined):shop.place_order("retry",[("book",2)],member=member)
+            self.assertEqual(snapshot(inv,ledger,shop),before)
+            self.assertFalse(ledger.decline_next)
+            r=shop.place_order("retry",[("book",2)],member=member)
+            self.assertEqual(r.paid_cents,amount);self.assertEqual(inv.stock["book"],1)
+            self.assertEqual(ledger.charges,{"retry":amount});self.assertEqual(ledger.charge_count,1)
+            self.assertIs(shop.place_order("retry",[("book",1)],member=not member),r)
+            self.assertEqual(inv.stock["book"],1);self.assertEqual(ledger.charge_count,1)
+    def test_unexpected_charge_error_releases_stock(self):
+        inv,ledger,shop=make({"book":3})
+        def boom(request_id, amount):raise RuntimeError("gateway")
+        ledger.charge=boom
+        before=snapshot(inv,ledger,shop)
+        with self.assertRaises(RuntimeError):shop.place_order("x",[("book",1),("book",1)],member=True)
+        self.assertEqual(snapshot(inv,ledger,shop),before)
+
+class PreserveTests(unittest.TestCase):
+    def test_gross_totals_unaffected_by_member_orders(self):
+        lines=[("bag",1),("book",1)]
+        inv,ledger,shop=make({"bag":1,"book":1})
+        self.assertEqual(shop.place_order("g",lines,member=True).paid_cents,18800)
+        self.assertEqual(calculate_total(lines),20000)
+        self.assertEqual(export_subtotal(lines),{"gross_cents":20000})
+    def test_existing_receipts_never_rewritten(self):
+        inv,ledger,shop=make({"book":5})
+        r1=shop.place_order("r1",[("book",1)])
+        r2=shop.place_order("r2",[("book",1)],member=True)
+        shop.place_order("r1",[("book",1)],member=True)
+        self.assertEqual(export_receipt(r1),{"receipt_id":"r1","amount_cents":5000})
+        self.assertEqual(export_receipt(r2),{"receipt_id":"r2","amount_cents":4250})
+        self.assertIs(shop.receipts["r1"],r1);self.assertIs(shop.receipts["r2"],r2)
+        self.assertEqual(ledger.charges,{"r1":5000,"r2":4250});self.assertEqual(ledger.charge_count,2)
+    def test_prices_unchanged(self):
+        original=dict(catalog.PRICES)
+        inv,ledger,shop=make({"book":1,"pen":1,"bag":1})
+        shop.place_order("pr",[("book",1),("pen",1),("bag",1)],member=True)
+        self.assertEqual(catalog.PRICES,original)
+        self.assertEqual(catalog.PRICES,{"book":5000,"pen":500,"bag":15000})
+
+if __name__ == "__main__":
+    unittest.main()
