diff --git a/src/storeflow/pricing.py b/src/storeflow/pricing.py
index a2db21a..bbbabf8 100644
--- a/src/storeflow/pricing.py
+++ b/src/storeflow/pricing.py
@@ -1,4 +1,15 @@
 from .catalog import subtotal
 
+MEMBER_DISCOUNT_PERCENT = 10
+MEMBER_DISCOUNT_CAP_CENTS = 2000
+
 def calculate_total(lines):
     return subtotal(lines)
+
+def member_discount(subtotal_cents):
+    return min(subtotal_cents * MEMBER_DISCOUNT_PERCENT // 100, MEMBER_DISCOUNT_CAP_CENTS)
+
+def quote(lines, member=False):
+    gross = calculate_total(lines)
+    discount = member_discount(gross) if member else 0
+    return {"subtotal_cents": gross, "discount_cents": discount, "total_cents": gross - discount}
