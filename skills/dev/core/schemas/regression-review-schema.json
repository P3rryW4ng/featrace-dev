{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Historical fix regression review",
  "type": "object",
  "required": ["schema_version", "feature_id", "scope", "candidates", "review_digest", "dispositions"],
  "properties": {
    "schema_version": {"const": 1},
    "feature_id": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "required": ["modules", "paths"],
      "properties": {
        "modules": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "candidates": {"type": "array", "items": {"type": "object"}},
    "review_digest": {"type": "string", "minLength": 1},
    "dispositions": {"type": "array", "items": {"type": "object"}}
  }
}
